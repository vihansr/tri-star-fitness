# MongoDB connection string. If the database is unreachable the API
# automatically falls back to built-in seed content so the site still works.
MONGODB_URI="mongodb://127.0.0.1:27017/tristar_fitness"

# Port the Express API listens on (Vite proxies /api here).
PORT="3001"

# Comma-separated list of allowed browser origins (production CORS).
CLIENT_ORIGIN="http://localhost:3000"
