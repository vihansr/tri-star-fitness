{
    "name": "tristar-fitness-mern",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=18.17"
    },
    "scripts": {
        "dev": "concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
        "dev:server": "node --watch server/index.js",
        "dev:client": "vite --port=3000 --host=0.0.0.0",
        "build": "vite build",
        "start": "cross-env NODE_ENV=production node server/index.js",
        "seed": "node server/seed.js",
        "test": "node src/logic.test.js"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "d3": "^7.9.0",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "mongoose": "^8.9.0",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^9.1.2",
        "cross-env": "^10.0.0",
        "vite": "^8.3.0"
    }
}